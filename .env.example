# Aro Environment Configuration
# Valid ARO_ENV values: demo, dev, prod
ARO_ENV=demo
AWS_REGION=us-east-1
LOG_LEVEL=INFO

# Application & API
ARO_API_URL=http://localhost:8000
VITE_API_BASE_URL=http://localhost:8000

# AWS Serverless Infrastructure
ARO_TABLE_NAME=aro-main-table-demo
ARO_EVIDENCE_BUCKET=aro-evidence-demo
ARO_EVENT_BUS_NAME=aro-events-demo
ARO_BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# Secrets (SSM Parameter / Local Mock)
# In AWS: resolved via /aro/{ARO_ENV}/ring/webhook-secret
RING_WEBHOOK_SECRET=demo-secret-key-12345
